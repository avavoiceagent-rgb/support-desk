# --- Server ---
PORT=4000
NODE_ENV=development
# Base URL where this app is reachable (used to build the Google OAuth redirect URI).
# Locally this is http://localhost:4000 ; in production it's your Railway URL.
APP_BASE_URL=http://localhost:4000

# --- Database ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ticketing"

# --- Auth ---
# Any long random string. Generate one with: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-string

# --- Token encryption ---
# 32-byte key, base64-encoded, used to encrypt Gmail refresh tokens at rest.
# Generate one with: openssl rand -base64 32
# IMPORTANT: back this up somewhere safe. If it's lost, every connected mailbox
# must be reconnected. Treat it like a password.
ENCRYPTION_KEY=replace-with-a-generated-key

# --- Google OAuth (Gmail) ---
# From Google Cloud Console > APIs & Services > Credentials.
# See docs/GOOGLE_OAUTH_SETUP.md for the full walkthrough.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match a redirect URI configured on the OAuth client:
GOOGLE_REDIRECT_URI=http://localhost:4000/api/email-accounts/gmail/callback

# --- Mail polling ---
MAIL_POLL_INTERVAL_MS=60000

# --- Optional: shared secret for an external poll trigger ---
# When set, GET /api/email-accounts/cron-poll?key=<value> triggers a mail
# check without a login. Leave empty to disable that endpoint entirely.
CRON_SECRET=

# --- Optional: AI triage ---
# An Anthropic API key (console.anthropic.com) switches on automatic sorting
# of incoming email into queues, and New/Change + Internal/External labels on
# reservation tickets. Leave empty and triage is simply off — nothing else
# changes. Note that with this enabled the first inbound email of each new
# ticket is sent to the Anthropic API for classification.
ANTHROPIC_API_KEY=
